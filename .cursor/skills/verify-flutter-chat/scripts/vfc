#!/usr/bin/env bash
# Verification harness for examples/flutter_chat: a release web build served on
# loopback, the pinned JS reference backend, and a headless Chromium that
# drive.cjs controls over CDP. Every call needs VERIFY_RUN_ID; each run owns its
# ports, build, browser profile and evidence directory.
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO="$(cd "$SKILL_DIR/../../.." && pwd)"
APP_DIR="$REPO/examples/flutter_chat"
BACKEND_DIR="$REPO/examples/remote_backend/js"
RUNS_ROOT="${VFC_RUNS_ROOT:-/tmp/verify-flutter-chat/runs}"
EVIDENCE_ROOT="${VFC_EVIDENCE_ROOT:-/tmp/verify-flutter-chat/evidence}"
CHROMIUM="${CHROMIUM:-$(command -v chromium || command -v chromium-browser || command -v google-chrome || true)}"
if [[ -z "${FLUTTER:-}" ]]; then
  if command -v fvm >/dev/null; then FLUTTER="fvm flutter"; else FLUTTER="flutter"; fi
fi
BACKEND_AI_VERSION=7.0.111

die() { echo "vfc: $*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage: VERIFY_RUN_ID=<id> vfc <command> [args]

  new                      Print a fresh run id (no state is created).
  build                    Allocate ports, pub get, build web with the run's backend URL.
  up                       Start backend, static web server and headless Chromium; wait until ready.
  doctor                   Read-only health check of this run's instance. Non-zero exit on failure.
  browser <cmd> [args]     Drive the app (see drive.cjs: open, tab, click, type, send, ...).
  scenario <name>          Run a canned end-to-end proof (see drive.cjs scenario list).
  backend stop|start       Stop or restart only this run's reference backend.
  env                      Print this run's ports, URLs and paths.
  down                     Kill this run's processes and delete its scratch dir. Keeps evidence.
EOF
}

require_run() {
  [[ -n "${VERIFY_RUN_ID:-}" ]] || die "set VERIFY_RUN_ID (try: vfc new)"
  [[ "$VERIFY_RUN_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "VERIFY_RUN_ID must start with a letter or digit and contain only [A-Za-z0-9._-]"
  RUN_DIR="$RUNS_ROOT/$VERIFY_RUN_ID"
  EVIDENCE_DIR="$EVIDENCE_ROOT/$VERIFY_RUN_ID"
  STATE="$RUN_DIR/state.env"
  [[ ! -L "$RUN_DIR" ]] || die "run directory must not be a symlink: $RUN_DIR"
  [[ ! -L "$EVIDENCE_DIR" ]] || die "evidence directory must not be a symlink: $EVIDENCE_DIR"
  python3 - "$RUNS_ROOT" "$RUN_DIR" "$EVIDENCE_DIR" <<'PY' || die "run/evidence paths overlap or run path escapes its root"
import os, sys
root, run, evidence = map(os.path.realpath, sys.argv[1:])
if os.path.dirname(run) != root or os.path.commonpath((run, evidence)) == run:
    raise SystemExit(1)
PY
}

load_state() {
  [[ -f "$STATE" ]] || die "no state for run $VERIFY_RUN_ID; run 'vfc build' first"
  local key value
  while IFS='=' read -r key value; do
    case "$key" in
      WEB_PORT|BACKEND_PORT|CDP_PORT)
        [[ "$value" =~ ^[0-9]{1,5}$ ]] && ((value >= 1 && value <= 65535)) || die "invalid $key in run state"
        printf -v "$key" '%s' "$value" ;;
      BUILD_FINGERPRINT|BUILD_SHA256)
        [[ "$value" =~ ^[a-f0-9]{64}$ ]] || die "invalid build fingerprint in run state"
        printf -v "$key" '%s' "$value" ;;
      BUILD_OK) [[ "$value" == yes || "$value" == no ]] || die "invalid build status in run state"; BUILD_OK="$value" ;;
      BUILD_HEAD) [[ "$value" =~ ^[a-f0-9]{7,40}$ ]] || die "invalid build head in run state"; BUILD_HEAD="$value" ;;
      BACKEND_URL) [[ "$value" =~ ^http://127\.0\.0\.1:[0-9]{1,5}/chat$ ]] || die "invalid backend URL in run state"; BACKEND_URL="$value" ;;
      KEY_BAKED) [[ "$value" == yes || "$value" == no ]] || die "invalid key metadata in run state"; KEY_BAKED="$value" ;;
      '') ;;
      *) die "unknown field in run state: $key" ;;
    esac
  done <"$STATE"
  [[ -n "${WEB_PORT:-}" && -n "${BACKEND_PORT:-}" && -n "${CDP_PORT:-}" ]] || die "incomplete run state"
}

free_port() {
  python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()'
}

source_fingerprint() {
  # The workspace lock/config files are ignored by Git but resolve the actual
  # versions and local paths compiled into a workspace build.
  (
    cd "$REPO"
    git rev-parse HEAD
    git diff HEAD -- packages examples/flutter_chat pubspec.yaml pubspec.lock .fvmrc
    git ls-files -o --exclude-standard -z -- packages examples/flutter_chat \
      | sort -z | while IFS= read -r -d '' f; do
        case "$f" in */build/*|*/.dart_tool/*) continue ;; esac
        sha256sum "$f"
      done
    find packages examples/flutter_chat -path '*/.dart_tool/package_config.json' -type f -print0 \
      | sort -z | xargs -0 -r sha256sum
    for f in pubspec.lock .dart_tool/package_config.json; do
      if [[ -f "$f" ]]; then sha256sum "$f"; else printf 'missing %s\n' "$f"; fi
    done
  ) | sha256sum | cut -d' ' -f1
}

require_current_build() {
  [[ -f "$RUN_DIR/web/main.dart.js" ]] || die "no web build; run 'vfc build'"
  [[ "${BUILD_OK:-no}" == yes ]] || die "last build did not complete; run 'vfc build'"
  [[ -n "${BUILD_FINGERPRINT:-}" && -n "${BUILD_SHA256:-}" ]] || die "build metadata missing; run 'vfc build'"
  [[ "$(source_fingerprint)" == "$BUILD_FINGERPRINT" ]] || die "build is stale; run 'vfc build'"
  [[ "$(sha256sum "$RUN_DIR/web/main.dart.js" | cut -d' ' -f1)" == "$BUILD_SHA256" ]] || die "web build artifact changed; run 'vfc build'"
  grep -Fq "http://127.0.0.1:$BACKEND_PORT/chat" "$RUN_DIR/web/main.dart.js" || die "build targets a different backend; run 'vfc build'"
}

pid_alive() { [[ -n "${1:-}" ]] && kill -0 "$1" 2>/dev/null; }
group_alive() { [[ "${1:-}" =~ ^[0-9]+$ ]] && kill -0 -- "-$1" 2>/dev/null; }

proc_identity() {
  [[ -r "/proc/$1/stat" ]] || return 1
  sed 's/^.*) //' "/proc/$1/stat" | awk '{print $1, $3, $20}'
}

owns_process_group() {
  local pid="$1" expected_start="$2" identity state pgid start
  identity="$(proc_identity "$pid")" || return 1
  read -r state pgid start <<<"$identity"
  [[ "$start" == "$expected_start" && "$pgid" == "$pid" ]]
}

read_pid() { [[ -f "$RUN_DIR/$1.pid" ]] && awk 'NR==1 {print $1}' "$RUN_DIR/$1.pid" || true; }
read_pid_start() { [[ -f "$RUN_DIR/$1.pid" ]] && awk 'NR==1 {print $2}' "$RUN_DIR/$1.pid" || true; }

listener_pid() {
  ss -ltnpH "sport = :$1" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2
}

# The listener must be our recorded process or a member of its process group
# (Chromium's CDP socket can live in a child of the launched process).
port_owned_by() {
  local port="$1" pid="$2" name="$3" lp
  owns_process_group "$pid" "$(read_pid_start "$name")" || return 1
  lp="$(listener_pid "$port")"
  [[ -n "$lp" ]] || return 1
  [[ "$lp" == "$pid" ]] && return 0
  [[ "$(ps -o pgid= -p "$lp" | tr -d ' ')" == "$pid" ]]
}

wait_until() {
  local what="$1" timeout="$2"; shift 2
  local deadline=$((SECONDS + timeout))
  until "$@" >/dev/null 2>&1; do
    ((SECONDS < deadline)) || die "$what not ready after ${timeout}s"
    sleep 0.5
  done
}

backend_ready() {
  [[ "$(curl --connect-timeout 2 --max-time 5 -s -o /dev/null -w '%{http_code}' -X OPTIONS "http://127.0.0.1:$BACKEND_PORT/chat")" == 204 ]]
}
web_ready() { curl --connect-timeout 2 --max-time 5 -sf "http://127.0.0.1:$WEB_PORT/main.dart.js" -o /dev/null; }
cdp_ready() { curl --connect-timeout 2 --max-time 5 -sf "http://127.0.0.1:$CDP_PORT/json/version" -o /dev/null; }

start_group() {
  # setsid gives the child its own process group so 'down' can kill exactly the
  # tree this run started and nothing else.
  local name="$1" log="$2"; shift 2
  setsid "$@" >"$log" 2>&1 < /dev/null &
  local pid=$! start
  for _ in $(seq 1 20); do
    start="$(proc_identity "$pid" | awk '{print $3}')"
    [[ -n "$start" ]] && break
    sleep 0.05
  done
  [[ -n "$start" ]] || die "could not record identity for $name process $pid"
  echo "$pid $start" >"$RUN_DIR/$name.pid"
}

stop_group() {
  local name="$1" pid
  pid="$(read_pid "$name")"
  local start
  start="$(read_pid_start "$name")"
  if pid_alive "$pid"; then
    owns_process_group "$pid" "$start" || { echo "refusing to stop $name: recorded process identity no longer matches" >&2; return 1; }
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    for _ in $(seq 1 20); do group_alive "$pid" || break; sleep 0.25; done
    group_alive "$pid" && kill -KILL -- "-$pid" 2>/dev/null || true
    rm -f "$RUN_DIR/$name.pid"
    echo "stopped $name (pgid $pid)"
  elif group_alive "$pid"; then
    echo "refusing to stop $name: process-group leader exited; inspect group $pid" >&2
    return 1
  else
    rm -f "$RUN_DIR/$name.pid"
  fi
}

ensure_backend_deps() {
  local installed
  installed="$(node -p "require('$BACKEND_DIR/node_modules/ai/package.json').version" 2>/dev/null || true)"
  if [[ "$installed" != "$BACKEND_AI_VERSION" ]]; then
    echo "installing pinned backend deps (npm ci)..."
    npm ci --ignore-scripts --prefix "$BACKEND_DIR" >/dev/null
  fi
}

cmd_build() {
  require_run
  mkdir -p "$RUN_DIR" "$EVIDENCE_DIR"
  if [[ ! -f "$STATE" ]]; then
    local web backend cdp
    web="$(free_port)"; backend="$(free_port)"; cdp="$(free_port)"
    cat >"$STATE" <<EOF
WEB_PORT=$web
BACKEND_PORT=$backend
CDP_PORT=$cdp
EOF
  fi
  load_state
  echo 'BUILD_OK=no' >>"$STATE"
  local backend_url="http://127.0.0.1:$BACKEND_PORT/chat"
  local defines=(--dart-define=REMOTE_BACKEND_URL="$backend_url")
  local key_baked=no
  if [[ -n "${OPENAI_API_KEY:-}" ]]; then
    defines+=(--dart-define=OPENAI_API_KEY="$OPENAI_API_KEY")
    key_baked=yes
  fi
  echo "building flutter_chat web for run $VERIFY_RUN_ID (backend $backend_url, OpenAI key baked: $key_baked)"
  echo "log: $RUN_DIR/build.log"
  $FLUTTER pub get >"$RUN_DIR/build.log" 2>&1 || { tail -30 "$RUN_DIR/build.log" >&2; die "pub get failed"; }
  local fingerprint
  fingerprint="$(source_fingerprint)"
  # --no-web-resources-cdn keeps CanvasKit local.
  (cd "$APP_DIR" && $FLUTTER build web --release --no-pub --no-wasm-dry-run --no-web-resources-cdn \
    "${defines[@]}" -o "$RUN_DIR/web") >>"$RUN_DIR/build.log" 2>&1 || { tail -30 "$RUN_DIR/build.log" >&2; die "build failed"; }
  local artifact_hash
  artifact_hash="$(sha256sum "$RUN_DIR/web/main.dart.js" | cut -d' ' -f1)"
  {
    echo "BACKEND_URL=$backend_url"
    echo "KEY_BAKED=$key_baked"
    echo "BUILD_FINGERPRINT=$fingerprint"
    echo "BUILD_SHA256=$artifact_hash"
    echo "BUILD_HEAD=$(git -C "$REPO" rev-parse --short HEAD)"
    echo "BUILD_OK=yes"
  } >>"$STATE"
  ensure_backend_deps
  echo "built: $RUN_DIR/web"
}

cmd_up() {
  require_run; load_state
  require_current_build
  [[ -n "$CHROMIUM" ]] || die "no Chromium found; set CHROMIUM=/path/to/chrome"
  for name in backend web chromium; do
    local pid start
    pid="$(read_pid "$name")"; start="$(read_pid_start "$name")"
    if pid_alive "$pid"; then
      owns_process_group "$pid" "$start" || die "$name pid file points to a different live process; inspect it before cleanup"
      die "$name already running for run $VERIFY_RUN_ID; use 'vfc doctor' or 'vfc down'"
    fi
    group_alive "$pid" && die "$name group still exists without its leader; inspect group $pid before restarting"
  done
  for port in "$WEB_PORT" "$BACKEND_PORT" "$CDP_PORT"; do
    [[ -z "$(listener_pid "$port")" ]] || die "port $port is taken by another process; use a new VERIFY_RUN_ID"
  done
  ensure_backend_deps
  cleanup_up() { local name; for name in chromium web backend; do stop_group "$name" || true; done; }
  trap cleanup_up EXIT INT TERM
  start_group backend "$RUN_DIR/backend.log" env -C "$BACKEND_DIR" PORT="$BACKEND_PORT" node server.mjs
  start_group web "$RUN_DIR/web.log" python3 -m http.server "$WEB_PORT" --bind 127.0.0.1 --directory "$RUN_DIR/web"
  start_group chromium "$RUN_DIR/chromium.log" "$CHROMIUM" --headless=new --no-sandbox \
    --remote-debugging-address=127.0.0.1 --remote-debugging-port="$CDP_PORT" \
    --user-data-dir="$RUN_DIR/profile" --no-first-run --no-default-browser-check \
    --window-size=1280,900 about:blank
  wait_until "backend :$BACKEND_PORT" 30 backend_ready
  wait_until "web :$WEB_PORT" 30 web_ready
  wait_until "chromium CDP :$CDP_PORT" 30 cdp_ready
  for pair in "backend:$BACKEND_PORT" "web:$WEB_PORT" "chromium:$CDP_PORT"; do
    name="${pair%%:*}"
    port_owned_by "${pair##*:}" "$(read_pid "$name")" "$name" || die "$name did not acquire its recorded port"
  done
  trap - EXIT INT TERM
  echo "ready: app http://127.0.0.1:$WEB_PORT  backend http://127.0.0.1:$BACKEND_PORT/chat  cdp :$CDP_PORT"
}

cmd_doctor() {
  require_run
  local fail=0
  ok() { echo "OK   $*"; }
  bad() { echo "FAIL $*"; fail=1; }
  if [[ ! -f "$STATE" ]]; then echo "FAIL no state for run $VERIFY_RUN_ID (run 'vfc build')"; exit 1; fi
  load_state
  if [[ -f "$RUN_DIR/web/main.dart.js" ]]; then ok "web build present ($RUN_DIR/web)"; else bad "web build missing"; fi
  if [[ "${BUILD_OK:-no}" == yes ]]; then ok "last build completed"; else bad "last build did not complete; run 'vfc build'"; fi
  if [[ -n "${BUILD_SHA256:-}" && -f "$RUN_DIR/web/main.dart.js" ]] && [[ "$(sha256sum "$RUN_DIR/web/main.dart.js" | cut -d' ' -f1)" == "$BUILD_SHA256" ]]; then
    ok "web build artifact matches recorded SHA-256"
  else
    bad "web build artifact changed or has no hash; run 'vfc build'"
  fi
  if grep -Fq "http://127.0.0.1:$BACKEND_PORT/chat" "$RUN_DIR/web/main.dart.js" 2>/dev/null; then
    ok "build targets backend http://127.0.0.1:$BACKEND_PORT/chat"
  else
    bad "build does not contain http://127.0.0.1:$BACKEND_PORT/chat (rebuild)"
  fi
  if [[ "$(source_fingerprint)" == "${BUILD_FINGERPRINT:-}" ]]; then
    ok "build matches current source (HEAD ${BUILD_HEAD:-unknown} + working tree)"
  else
    bad "build is stale: source changed since build; run 'vfc build', then reload with 'vfc browser open <route>'"
  fi
  echo "INFO OpenAI key baked into build: ${KEY_BAKED:-no} (Chat/Completion/Object need yes)"
  local name port pid
  for pair in "backend:$BACKEND_PORT" "web:$WEB_PORT" "chromium:$CDP_PORT"; do
    name="${pair%%:*}"; port="${pair##*:}"; pid="$(read_pid "$name")"
    if ! pid_alive "$pid"; then bad "$name not running"; continue; fi
    if port_owned_by "$port" "$pid" "$name"; then ok "$name pid $pid owns :$port"; else bad "$name pid $pid does not own :$port"; fi
  done
  local headers
  headers="$(curl --connect-timeout 2 --max-time 5 -s -i -X OPTIONS "http://127.0.0.1:$BACKEND_PORT/chat" 2>/dev/null || true)"
  if grep -qi '^access-control-expose-headers: x-vercel-ai-ui-message-stream' <<<"$headers"; then
    ok "backend answers CORS preflight with the UI-stream header exposed"
  else
    bad "backend preflight failed"
  fi
  local served_hash
  if served_hash="$(curl --connect-timeout 2 --max-time 5 -fsS "http://127.0.0.1:$WEB_PORT/main.dart.js" 2>/dev/null | sha256sum | cut -d' ' -f1)" && [[ -n "${BUILD_SHA256:-}" && "$served_hash" == "$BUILD_SHA256" ]]; then
    ok "web serves the recorded main.dart.js artifact"
  else
    bad "web not serving the recorded main.dart.js artifact"
  fi
  local version
  version="$(curl --connect-timeout 2 --max-time 5 -sf "http://127.0.0.1:$CDP_PORT/json/version" | python3 -c 'import json,sys; print(json.load(sys.stdin)["Browser"])' 2>/dev/null || true)"
  if [[ -n "$version" ]]; then ok "chromium CDP answers ($version)"; else bad "chromium CDP not answering"; fi
  echo "INFO evidence: $EVIDENCE_DIR"
  exit "$fail"
}

cmd_backend() {
  require_run; load_state
  case "${1:-}" in
    stop) stop_group backend ;;
    start)
      local pid start
      pid="$(read_pid backend)"; start="$(read_pid_start backend)"
      if pid_alive "$pid"; then
        owns_process_group "$pid" "$start" || die "backend pid file points to a different live process; inspect it before cleanup"
        die "backend already running"
      fi
      group_alive "$pid" && die "backend group still exists without its leader; run 'vfc down' and inspect it"
      [[ -z "$(listener_pid "$BACKEND_PORT")" ]] || die "backend port $BACKEND_PORT is taken by another process"
      trap 'stop_group backend || true' EXIT
      start_group backend "$RUN_DIR/backend.log" env -C "$BACKEND_DIR" PORT="$BACKEND_PORT" node server.mjs
      wait_until "backend :$BACKEND_PORT" 30 backend_ready
      port_owned_by "$BACKEND_PORT" "$(read_pid backend)" backend || die "backend did not acquire its recorded port"
      trap - EXIT
      echo "backend ready on :$BACKEND_PORT" ;;
    *) die "usage: vfc backend stop|start" ;;
  esac
}

cmd_env() {
  require_run; load_state
  cat <<EOF
VERIFY_RUN_ID=$VERIFY_RUN_ID
APP_URL=http://127.0.0.1:$WEB_PORT
BACKEND_URL=${BACKEND_URL:-http://127.0.0.1:$BACKEND_PORT/chat}
CDP_URL=http://127.0.0.1:$CDP_PORT
RUN_DIR=$RUN_DIR
EVIDENCE_DIR=$EVIDENCE_DIR
KEY_BAKED=${KEY_BAKED:-no}
EOF
}

cmd_drive() {
  require_run; load_state
  require_current_build
  mkdir -p "$EVIDENCE_DIR"
  local pair name
  for pair in "web:$WEB_PORT" "chromium:$CDP_PORT"; do
    name="${pair%%:*}"
    port_owned_by "${pair##*:}" "$(read_pid "$name")" "$name" || die "$name does not own its recorded port for run $VERIFY_RUN_ID; run 'vfc doctor'"
  done
  VFC_WEB_PORT="$WEB_PORT" VFC_CDP_PORT="$CDP_PORT" VFC_EVIDENCE_DIR="$EVIDENCE_DIR" \
    VFC_RUN_DIR="$RUN_DIR" VFC_NPM_GLOBAL="$(npm root -g 2>/dev/null || true)" node "$SKILL_DIR/scripts/drive.cjs" "$@"
}

cmd_down() {
  require_run
  [[ -d "$RUN_DIR" ]] || { echo "nothing to clean for run $VERIFY_RUN_ID"; echo "evidence kept: $EVIDENCE_DIR"; return; }
  local cleanup_failed=0
  for name in chromium web backend; do stop_group "$name" || cleanup_failed=1; done
  [[ "$cleanup_failed" == 0 ]] || die "one or more process groups could not be safely verified; run directory retained"
  # Scratch only: build (may contain a baked API key), browser profile, logs.
  rm -rf "$RUN_DIR"
  echo "removed $RUN_DIR"
  echo "evidence kept: $EVIDENCE_DIR"
}

case "${1:-}" in
  new) echo "vfc-$(date +%Y%m%d-%H%M%S)-$RANDOM" ;;
  build) cmd_build ;;
  up) cmd_up ;;
  doctor) cmd_doctor ;;
  browser) shift; cmd_drive "$@" ;;
  scenario) shift; cmd_drive scenario "$@" ;;
  backend) shift; cmd_backend "$@" ;;
  env) cmd_env ;;
  down) cmd_down ;;
  -h|--help|help|"") usage ;;
  *) usage; exit 2 ;;
esac
